<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="laporan_penerimaan"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    whenNoDataType="AllSectionsNoDetail">

    <!-- ================= STYLES ================= -->

    <style name="TitleStyle"
        fontName="SansSerif"
        fontSize="19"
        isBold="true"
        forecolor="#FFFFFF"/>

    <style name="SubtitleStyle"
        fontName="SansSerif"
        fontSize="9"
        forecolor="#CBD5E1"/>

    <style name="CardLabel"
        fontName="SansSerif"
        fontSize="9"
        forecolor="#64748B"/>

    <style name="CardValue"
        fontName="SansSerif"
        fontSize="17"
        isBold="true"
        forecolor="#0F172A"/>

    <style name="TableHeader"
        mode="Opaque"
        backcolor="#1E3A5F"
        forecolor="#FFFFFF"
        fontName="SansSerif"
        fontSize="9"
        isBold="true"
        hAlign="Center"
        vAlign="Middle">
        <box
            leftPadding="5"
            rightPadding="5"
            topPadding="3"
            bottomPadding="3">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </box>
    </style>

    <style name="TableCell"
        mode="Opaque"
        backcolor="#FFFFFF"
        forecolor="#334155"
        fontName="SansSerif"
        fontSize="8"
        vAlign="Middle">
        <box
            leftPadding="5"
            rightPadding="5"
            topPadding="3"
            bottomPadding="3">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </box>
        <conditionalStyle>
            <conditionExpression><![CDATA[
                $V{REPORT_COUNT}.intValue() % 2 == 0
            ]]></conditionExpression>
            <style mode="Opaque" backcolor="#F1F5F9"/>
        </conditionalStyle>
    </style>

    <style name="TotalStyle"
        mode="Opaque"
        backcolor="#E0F2F1"
        forecolor="#0F766E"
        fontName="SansSerif"
        fontSize="10"
        isBold="true"
        vAlign="Middle">
        <box
            leftPadding="5"
            rightPadding="5"
            topPadding="3"
            bottomPadding="3">
            <pen lineWidth="0.5" lineColor="#99F6E4"/>
        </box>
    </style>

    <!-- ================= PARAMETERS ================= -->

    <parameter name="PERIOD_TEXT" class="java.lang.String"/>
    <parameter name="TOTAL_REVENUE" class="java.math.BigDecimal"/>
    <parameter name="PAYMENT_COUNT" class="java.lang.Integer"/>

    <!-- ================= FIELDS ================= -->

    <field name="paymentDate" class="java.lang.String"/>
    <field name="invoiceNumber" class="java.lang.String"/>
    <field name="tenantName" class="java.lang.String"/>
    <field name="roomNumber" class="java.lang.String"/>
    <field name="paymentMethod" class="java.lang.String"/>
    <field name="notes" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>

    <!-- ================= TITLE ================= -->

    <title>
        <band height="132">

            <!-- Main Header -->
            <rectangle>
                <reportElement
                    x="0" y="0"
                    width="802" height="78"
                    mode="Opaque"
                    backcolor="#172B4D"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <!-- Brand -->
            <staticText>
                <reportElement
                    x="22" y="12"
                    width="300" height="17"
                    forecolor="#5EEAD4"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[KOSTLY  /  PROPERTY MANAGEMENT]]></text>
            </staticText>

            <!-- Report Title -->
            <staticText>
                <reportElement
                    x="22" y="32"
                    width="520" height="29"
                    forecolor="#FFFFFF"/>
                <textElement>
                    <font size="19" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN PENERIMAAN SEWA]]></text>
            </staticText>

            <!-- Period -->
            <textField isBlankWhenNull="true">
                <reportElement
                    x="22" y="61"
                    width="500" height="13"
                    forecolor="#CBD5E1"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $P{PERIOD_TEXT}
                ]]></textFieldExpression>
            </textField>

            <!-- Accent -->
            <rectangle>
                <reportElement
                    x="770" y="0"
                    width="32" height="78"
                    mode="Opaque"
                    backcolor="#14B8A6"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <!-- Transaction Card -->
            <rectangle>
                <reportElement
                    x="0" y="89"
                    width="390" height="40"
                    mode="Opaque"
                    backcolor="#F1F5F9"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement
                    x="15" y="94"
                    width="180" height="13"
                    forecolor="#64748B"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[TOTAL TRANSAKSI]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="15" y="107"
                    width="350" height="19"
                    forecolor="#172B4D"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $P{PAYMENT_COUNT} == null
                    ? "0 Transaksi"
                    : $P{PAYMENT_COUNT} + " Transaksi"
                ]]></textFieldExpression>
            </textField>

            <!-- Revenue Card -->
            <rectangle>
                <reportElement
                    x="400" y="89"
                    width="402" height="40"
                    mode="Opaque"
                    backcolor="#E0F2F1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#99F6E4"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement
                    x="415" y="94"
                    width="180" height="13"
                    forecolor="#0F766E"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[TOTAL PENERIMAAN]]></text>
            </staticText>

            <textField pattern="'Rp' #,##0">
                <reportElement
                    x="415" y="107"
                    width="370" height="19"
                    forecolor="#0F766E"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $P{TOTAL_REVENUE}
                ]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <!-- ================= COLUMN HEADER ================= -->

    <columnHeader>
        <band height="28">

            <staticText>
                <reportElement
                    style="TableHeader"
                    x="0" y="0" width="78" height="28"/>
                <textElement/>
                <text><![CDATA[TANGGAL]]></text>
            </staticText>

            <staticText>
                <reportElement
                    style="TableHeader"
                    x="78" y="0" width="112" height="28"/>
                <textElement/>
                <text><![CDATA[NO. TAGIHAN]]></text>
            </staticText>

            <staticText>
                <reportElement
                    style="TableHeader"
                    x="190" y="0" width="158" height="28"/>
                <textElement/>
                <text><![CDATA[PENGHUNI]]></text>
            </staticText>

            <staticText>
                <reportElement
                    style="TableHeader"
                    x="348" y="0" width="62" height="28"/>
                <textElement/>
                <text><![CDATA[KAMAR]]></text>
            </staticText>

            <staticText>
                <reportElement
                    style="TableHeader"
                    x="410" y="0" width="92" height="28"/>
                <textElement/>
                <text><![CDATA[METODE]]></text>
            </staticText>

            <staticText>
                <reportElement
                    style="TableHeader"
                    x="502" y="0" width="148" height="28"/>
                <textElement/>
                <text><![CDATA[CATATAN]]></text>
            </staticText>

            <staticText>
                <reportElement
                    style="TableHeader"
                    x="650" y="0" width="152" height="28"/>
                <textElement/>
                <text><![CDATA[JUMLAH (RP)]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ================= DETAIL ================= -->

    <detail>
        <band height="25">

            <textField isBlankWhenNull="true">
                <reportElement
                    style="TableCell"
                    x="0" y="0" width="78" height="25"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    $F{paymentDate}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    style="TableCell"
                    x="78" y="0" width="112" height="25"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    $F{invoiceNumber}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    style="TableCell"
                    x="190" y="0" width="158" height="25"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    $F{tenantName}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    style="TableCell"
                    x="348" y="0" width="62" height="25"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    $F{roomNumber}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    style="TableCell"
                    x="410" y="0" width="92" height="25"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    $F{paymentMethod}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    style="TableCell"
                    x="502" y="0" width="148" height="25"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    $F{notes}
                ]]></textFieldExpression>
            </textField>

            <textField
                pattern="'Rp' #,##0"
                isBlankWhenNull="true">
                <reportElement
                    style="TableCell"
                    x="650" y="0" width="152" height="25"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    $F{amount}
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ================= FOOTER ================= -->

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="802" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#CBD5E1"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="7" width="400" height="14" forecolor="#64748B"/>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[KOSTLY - Sistem Manajemen Kost]]></text>
            </staticText>
            <textField>
                <reportElement x="650" y="7" width="152" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ================= SUMMARY ================= -->

    <summary>
        <band height="48">

            <staticText>
                <reportElement
                    style="TotalStyle"
                    x="502" y="10"
                    width="148" height="28"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[TOTAL PENERIMAAN]]></text>
            </staticText>

            <textField pattern="'Rp' #,##0">
                <reportElement
                    style="TotalStyle"
                    x="650" y="10"
                    width="152" height="28"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    $P{TOTAL_REVENUE}
                ]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
